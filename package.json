{
  "name": "Queller-AI",
  "private": true,
  "scripts": {
    "lint:js": "eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "validate:schema": "node scripts/validate/ai-schema.js",
    "validate:refs": "node scripts/validate/ai-refs.js",
    "validate:conditions": "node scripts/validate/ai-conditions.js",
    "validate:base-install": "node scripts/validate/ai-base-install.js",
    "validate:docs": "node scripts/validate/docs.js",
    "validate": "npm run validate:schema && npm run validate:refs && npm run validate:conditions && npm run validate:docs && npm run validate:base-install",
    "test": "node --test",
    "verify": "npm run lint:js && npm run format:check && npm run validate && npm test",
    "refresh:vocabulary": "node scripts/refresh-engine-vocabulary.js",
    "refresh:inventory": "node scripts/refresh-tier-inventory.js"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-es-x": "^9.7.0",
    "eslint-plugin-lodash": "^8.1.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6"
  }
}
