# Auto detect text files and perform LF normalization
* text=auto

# Binary assets - never normalise line endings or attempt a text diff
*.png binary
*.jpg binary
*.gif binary

# GitHub (Linguist): collapse machine-generated files in PR diffs and keep them
# out of the language stats. -diff also stops git itself diffing the lockfile.
package-lock.json linguist-generated=true -diff
# Rebuilt by `npm run refresh:inventory` / `npm run refresh:vocabulary`; the prose
# lives in scripts/lib/*-reference.js, which is where edits go.
docs/tier-inventory.md linguist-generated=true
docs/engine-vocabulary.md linguist-generated=true
scripts/lib/engine-vocabulary.json linguist-generated=true -diff

# Keep development junk out of our ZIP files (git archive, GitHub "Download ZIP",
# release archives). What is left is what a player drops into server_mods.
.claude/ export-ignore
.github/ export-ignore
.sonarlint/ export-ignore
.vscode/ export-ignore
docs/ export-ignore
images/ export-ignore
scripts/ export-ignore
test/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.markdownlint.json export-ignore
.nvmrc export-ignore
.prettierignore export-ignore
.prettierrc export-ignore
CLAUDE.md export-ignore
CONTRIBUTING.md export-ignore
eslint.config.mjs export-ignore
package-lock.json export-ignore
package.json export-ignore
sonar-project.properties export-ignore
